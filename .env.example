# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1


# ==========================================
# DATABASE
# ==========================================

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bhaiway

# Integration tests use .env.test and database `bhaiway_test` on the same Docker Postgres.


# ==========================================
# REDIS
# ==========================================

# Preferred in production (Render / managed Redis). Supports redis:// and rediss://.
# Upstash (use Redis protocol URL from console — NOT the REST https:// URL):
#   rediss://default:<TOKEN>@<ENDPOINT>.upstash.io:6379
# Local:
#   redis://localhost:6379
REDIS_URL=

# Fallback when REDIS_URL is unset (local Docker / legacy).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional ACL username for discrete host/port config (not needed when embedded in REDIS_URL).
REDIS_USERNAME=


# ==========================================
# AUTHENTICATION
# ==========================================

JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
# Staging/testing: 12 days. Production should use a shorter access-token lifetime (e.g. 15m).
JWT_ACCESS_EXPIRES_IN=12d
# Reserved for a future refresh-token flow — not used by the current auth implementation.
JWT_REFRESH_EXPIRES_IN=30d

# MSG91 OTP Widget (server-side only — never expose real values here)
MSG91_AUTHKEY=
MSG91_WIDGET_ID=

# Development auth bypass (never enable in production)
DEV_AUTH_ENABLED=false
DEV_AUTH_PHONE=


# ==========================================
# SECURITY
# ==========================================

ENCRYPTION_KEY=CHANGE_ME


# ==========================================
# PAYMENT
# ==========================================

PAYMENT_GATEWAY_BASE_URL=
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=


# ==========================================
# FRONTEND
# ==========================================

FRONTEND_URL=http://localhost:3001


# ==========================================
# MAPS / ROUTE GEOMETRY
# ==========================================

# Optional. When set, ride publish/update stores a Google Directions overview
# polyline for 50km corridor search. When unset, a densified geodesic between
# source and destination coordinates is stored instead (no external API call).
GOOGLE_MAPS_API_KEY=
